#
# This script reads a CSV file from standard input (stdin) and creates multiple
# IMAPSYNC tasks based on the provided user data.
#

"""
IMAPSYNC Bulk User Import Tool - Create multiple sync tasks from CSV
"""

import csv
import glob
import string
import random
import sys
from typing import Tuple
import agent
import os

# Configuration constants
DELIMITER = ','  # Only comma-separated values supported
REQUIRED_COLUMNS = {
    'localusername', 'remoteusername', 'remotepassword',
    'remotehostname', 'remoteport', 'security'
}
COLUMN_MAPPING = {
    'localusername': 'localuser',
    'remoteusername': 'remoteusername',
    'remotepassword': 'remotepassword',
    'remotehostname': 'remotehostname',
    'remoteport': 'remoteport',
    'security': 'security',
}
MANDATORY_FIELDS = {'localusername', 'remoteusername', 'remotepassword', 'remotehostname', 'remoteport'}
DEFAULT_TASK_DATA = {
    'cron': '',
    'delete_local': False,
    'delete_remote': False,
    'delete_remote_older': 0,
    'exclude': '',
    'foldersynchronization': 'all',
    'sieve_enabled': False,
}


def generate_random_id(length: int = 6) -> str:
    """Generate random alphanumeric ID"""
    chars = string.ascii_letters + string.digits
    return ''.join(random.choices(chars, k=length)).lower()


def validate_and_load_csv() -> Tuple[bool, list]:
    """Validate CSV columns from stdin and load all rows in a single pass"""
    try:
        reader = csv.DictReader(sys.stdin, delimiter=DELIMITER)
        
        if reader.fieldnames is None:
            print("✗ Error: CSV input is empty or invalid")
            return False, []
        
        csv_columns = set(reader.fieldnames)
        missing = REQUIRED_COLUMNS - csv_columns
        
        print(f"\n📋 CSV Column Validation:")
        print(f"   Delimiter: '{DELIMITER}' (comma-separated)")
        print(f"   Found {len(csv_columns)} column(s): {', '.join(sorted(csv_columns))}")
        print(f"   Column order: does not matter (mapped by header name)")
        
        if missing:
            print(f"\n✗ Missing {len(missing)} required column(s):")
            for col in sorted(missing):
                print(f"   - {col}")
            return False, []
        
        print(f"✓ All {len(REQUIRED_COLUMNS)} required columns present")
        
        # Load all rows at once, filtering empty lines
        rows = []
        for row in reader:
            # Skip empty rows (all values are empty or whitespace)
            if all(not value.strip() for value in row.values()):
                continue
            rows.append(row)
        
        print(f"✓ Found {len(rows)} data row(s) (empty lines skipped)")
        return True, rows
    
    except Exception as e:
        print(f"✗ Error reading CSV ({type(e).__name__}): {str(e)}")
        return False, []


def parse_csv_row(row: dict, existing_ids: set) -> dict:
    """Parse CSV row and return task data dictionary"""
    task_data = DEFAULT_TASK_DATA.copy()
    
    # Generate unique task ID (retry if collision)
    max_attempts = 100
    for _ in range(max_attempts):
        task_id = generate_random_id()
        if task_id not in existing_ids:
            existing_ids.add(task_id)
            task_data['task_id'] = task_id
            break
    else:
        raise RuntimeError(f"Failed to generate unique task ID after {max_attempts} attempts")
    
    # Check mandatory fields are not empty
    missing_values = []
    for field in MANDATORY_FIELDS:
        if field not in row or not row[field].strip():
            missing_values.append(field)
    
    if missing_values:
        raise ValueError(f"Missing required value(s): {', '.join(sorted(missing_values))}")
    
    # Parse and populate fields
    for csv_key, json_key in COLUMN_MAPPING.items():
        if csv_key not in row:
            continue
        
        value = row[csv_key].strip()
        
        # Security can be empty (no encryption)
        if not value and csv_key != 'security':
            continue
        
        if json_key == 'remoteport':
            try:
                task_data[json_key] = int(value)
            except ValueError:
                raise ValueError(f"Invalid port number: '{value}'")
        else:
            task_data[json_key] = value
    
    return task_data


def existing_syncs() -> dict:
    """Maps each configured (local user, remote user, remote host) triple to its task id.

    A local user may legitimately sync from several remote accounts, so only the
    whole triple identifies the same sync twice.
    """
    syncs = {}
    for env_file in glob.iglob("imapsync/*.env"):
        env = agent.read_envfile(env_file)
        key = _sync_key(env.get('LOCALUSER', ''), env.get('REMOTEUSERNAME', ''),
                        env.get('REMOTEHOSTNAME', ''))
        syncs[key] = env.get('TASK_ID', '')
    return syncs


def _sync_key(localuser: str, remoteuser: str, remotehost: str) -> tuple:
    """Compared case insensitively. An IP and an FQDN of the same server still count as
    two different syncs: resolving them would mean a DNS lookup per row.
    """
    return (localuser.lower(), remoteuser.lower(), remotehost.lower())


def sync_key(task_data: dict) -> tuple:
    return _sync_key(task_data['localuser'], task_data['remoteusername'],
                     task_data['remotehostname'])


def create_task(module_id: str, task_data: dict, verb: str = 'Creating') -> bool:
    """Create a task via agent.tasks.run(). Reusing an existing task id updates it."""
    local_user = task_data.get('localuser', 'unknown')
    task_id = task_data.get('task_id', 'unknown')
    print(f"{verb} task for {local_user} (ID: {task_id})...")
    
    try:
        create_retval = agent.tasks.run(
            agent_id=os.environ['AGENT_ID'],
            action='create-task',
            data=task_data
        )
        if create_retval['exit_code'] != 0:
            # Not assert_exp: it exits, and SystemExit escapes the except below,
            # which would abort the whole import on one refused row.
            print(f"✗ Error for {local_user}: create-task exited {create_retval['exit_code']}")
            return False
        print(f"✓ Success: {local_user}")
        return True
    except Exception as e:
        print(f"✗ Error for {local_user}")
        print(f"  Error: {e}")
        return False

def print_help():
    """Display help message"""
    help_text = """
╔════════════════════════════════════════════════════════════════════════╗
║          IMAPSYNC Task Creator - Bulk User Import Tool                 ║
╚════════════════════════════════════════════════════════════════════════╝

USAGE:
    runagent -m imapsync1 import-csv-tasks [options] < users.csv

OPTIONS:
    -h, --help             : Show this help message
    -c, --check            : Check CSV format without creating tasks
    -u, --update           : Update the existing task instead of skipping it, which
                             is how credentials are changed in bulk. Rows already
                             configured are skipped otherwise, so an import can
                             safely be re-run

EXAMPLE:
    runagent -m imapsync1 import-csv-tasks < users.csv
    runagent -m imapsync1 import-csv-tasks -c < users.csv

INPUT:
    - Reads CSV data from standard input (stdin)
    - Pipe CSV file: cat users.csv | runagent -m imapsync1 import-csv-tasks

CSV FILE FORMAT:
    - Delimiter: comma (,) - required
    - Required columns: localusername, remoteusername, remotepassword,
                       remotehostname, remoteport, security
    - All required columns must be present in the header row

CSV HEADER EXAMPLE:
    localusername,remoteusername,remotepassword,remotehostname,remoteport,security

CSV DATA EXAMPLE:
    pansy.dumbledore5,user1@domain.com,"quotedPassword",imap.domain.com,993,ssl
    lavender.umbridge7,user2@domain.com,"quotedPassword",imap.domain.com,993,ssl

CREATED FIELDS (auto-populated):
    - task_id              : Random 6-character ID (auto-generated)
    - cron                 : Empty string (for scheduling)
    - delete_local         : false
    - delete_remote        : false
    - delete_remote_older  : 0
    - exclude              : Empty string
    - foldersynchronization: "all"
    - sieve_enabled        : false

TROUBLESHOOTING:
    - Check that CSV uses comma (,) as delimiter
    - Verify all 6 required columns are present in the CSV header
    - Make sure remoteport values are numeric (e.g., 993, 143)
    - Verify security values are valid (ssl, tls, empty '')
    """
    print(help_text)

def main():
    """Main entry point"""
    args = sys.argv[1:]
    
    # Handle help flags
    if '-h' in args or '--help' in args:
        print_help()
        sys.exit(0)
    
    # Handle check flag
    check_only = '-c' in args or '--check' in args
    if check_only:
        args = [arg for arg in args if arg not in ['-c', '--check']]
    
    update = '-u' in args or '--update' in args
    if update:
        args = [arg for arg in args if arg not in ['-u', '--update']]
    
    # Validate no extra arguments
    if len(args) != 0:
        print("✗ Error: Unexpected arguments")
        print("Usage: runagent -m imapsync1 import-csv-tasks [options]")
        sys.exit(1)
    
    module_id = os.environ.get('MODULE_ID', os.environ.get('AGENT_ID', 'unknown'))
    
    # Validate and load CSV from stdin
    print("Reading CSV from standard input...")
    is_valid, rows = validate_and_load_csv()
    
    if not is_valid:
        sys.exit(1)
    
    if check_only:
        print("\n🔍 Validating row data...")
        validation_errors = 0
        existing_ids = set()
        
        for idx, row in enumerate(rows, start=1):
            try:
                parse_csv_row(row, existing_ids)
            except ValueError as e:
                print(f"  ✗ Row {idx}: {str(e)}")
                validation_errors += 1
            except Exception as e:
                print(f"  ✗ Row {idx}: Unexpected error - {str(e)}")
                validation_errors += 1
        
        if validation_errors > 0:
            print(f"\n✗ Validation failed: {validation_errors} row(s) with errors")
            sys.exit(1)
        
        already = existing_syncs()
        duplicates = 0
        seen = set()
        for idx, row in enumerate(rows, start=1):
            try:
                key = sync_key(parse_csv_row(row, set()))
            except Exception:
                continue
            if key in already or key in seen:
                print(f"  ⊘ Row {idx}: {key[0]} already syncs {key[1]}@{key[2]}")
                duplicates += 1
            seen.add(key)
        print(f"✓ All {len(rows)} rows validated successfully")
        if duplicates:
            print(f"⊘ {duplicates} row(s) would be skipped as already configured, "
                  f"use --update to apply the file to them")
        print(f"✓ Generated {len(existing_ids)} unique task IDs")
        print("\n✓ CSV file is valid. No tasks were created (check-only mode).")
        sys.exit(0)
    
    # Process tasks
    print(f"\n📦 Starting task creation with module: {module_id}")
    print(f"   Processing {len(rows)} user(s)...\n")
    
    created = 0
    updated = 0
    failed = 0
    skipped = 0
    existing_ids = set()
    existing = existing_syncs()
    processed = set()
    
    for idx, row in enumerate(rows, start=1):
        try:
            task_data = parse_csv_row(row, existing_ids)
            key = sync_key(task_data)
            if key in processed:
                print(f"⊘ Skipped row {idx}: {key[1]}@{key[2]} appears twice in this file")
                skipped += 1
                print()
                continue
            processed.add(key)
            verb = 'Creating'
            if key in existing:
                if not update:
                    print(f"⊘ Skipped row {idx}: {key[0]} already syncs {key[1]}@{key[2]}")
                    skipped += 1
                    print()
                    continue
                # A fresh id would leave two crons racing on the same mailbox.
                task_data['task_id'] = existing[key]
                verb = 'Updating'
            if create_task(module_id, task_data, verb):
                if verb == 'Updating':
                    updated += 1
                else:
                    created += 1
            else:
                failed += 1
        except KeyError as e:
            print(f"✗ Missing field {e} on row {idx}")
            failed += 1
        except ValueError as e:
            print(f"✗ Invalid value on row {idx}: {str(e)}")
            failed += 1
        except Exception as e:
            print(f"✗ Unexpected error on row {idx}: {str(e)}")
            failed += 1
        print()
    
    # Summary
    print("=" * 70)
    summary = f"📊 Summary: {created} created, {failed} failed"
    if updated:
        summary += f", {updated} updated"
    if skipped:
        summary += f", {skipped} skipped"
    print(summary)
    print("=" * 70)
    
    # A skipped duplicate is not an error: re-running an import stays quiet.
    sys.exit(1 if failed > 0 else 0)


if __name__ == "__main__":
    main()
